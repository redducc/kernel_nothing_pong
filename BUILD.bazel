    kernel_modules = [
        ":external_modules",
    ],
)

ddk_uapi_headers(
    name = "ingot_ddk_uapi_headers",
    srcs = [
        "//vendor/osom/ingot-modules/qcom/opensource/audio-kernel:audio_uapi_headers",
        "//vendor/osom/ingot-modules/qcom/opensource/dataipa:dataipa_uapi_headers",
        "//vendor/osom/ingot-modules/qcom/opensource/display-drivers:uapi_headers",
        "//vendor/osom/ingot-modules/qcom/opensource/securemsm-kernel:securemsm_uapi_headers",
    ],
    out = "ddk-uapi-headers.tar.gz",
    kernel_build = "//vendor/osom/ingot-kernel:waipio_perf",
)

hermetic_genrule(
    name = "ingot_merged_kernel_uapi_headers",
    srcs = [
        "//vendor/osom/ingot-kernel:waipio_perf_uapi_headers",
        ":ingot_ddk_uapi_headers",
    ],
    outs = [
        "kernel-uapi-headers.tar.gz",
    ],
    cmd = """
        mkdir -p out
        tar -xzf $$(find bazel-out/ -name kernel-uapi-headers.tar.gz -print -quit) -C out
        tar -xzf $$(find bazel-out/ -name ddk-uapi-headers.tar.gz -print -quit) -C out
        tar -czf $(@D)/kernel-uapi-headers.tar.gz . -C out
    """,
)

pkg_files(
    name = "ingot_uapi_headers_dist_files",
    srcs = [
        ":ingot_merged_kernel_uapi_headers",
    ],
)

pkg_install(
    name = "ingot_uapi_headers_dist",
    srcs = [":ingot_uapi_headers_dist_files"],
    destdir = "out/osom_ingot/dist",
)

pkg_files(
    name = "ingot_dist_files",
    srcs = [
        "//vendor/osom/ingot-kernel:waipio_perf",
        ":modules_install",
        ":ingot_uapi_headers_dist_files",
        # Mixed build: Additional GKI artifacts.
        "//common:kernel_aarch64",
        "//common:kernel_aarch64_modules",
        "//common:kernel_aarch64_images_system_dlkm_image",
    ],
    strip_prefix = strip_prefix.files_only(),
)

pkg_install(
    name = "ingot_dist",
    srcs = [":ingot_dist_files"],
    destdir = "out/osom_ingot/dist",
)

kernel_abi(
    name = "ingot_abi",
    kernel_build = "//vendor/osom/ingot-kernel:waipio_perf",
    kernel_modules = [
        ":external_modules",
    ],
    module_grouping = False,
)
